shamefully-hoist=true
strict-peer-dependencies=false
# apps/mobile (Expo/RN) pulls @types/react@19 while apps/web, apps/marketing, apps/api
# stay on @types/react@18. shamefully-hoist=true would otherwise flatten both into the
# same root node_modules/@types/react, and whichever version wins poisons every other
# package's TypeScript typeRoots resolution (apps/marketing typecheck breaks with
# 'Link'/'Outlet' JSX errors when the react19 types win). Keep these two isolated per
# package instead of hoisted to root.
public-hoist-pattern[]=*
public-hoist-pattern[]=!@types/react
public-hoist-pattern[]=!@types/react-dom
