generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Référentiels globaux ─────────────────────────────────────────────────────

enum CurrencySymbolPosition {
  BEFORE
  AFTER
}

/// Devise globale de plateforme (partagée entre tous les tenants).
/// Seul un PlatformAdmin peut créer/modifier/désactiver une devise.
/// Un tenant choisit sa devise par défaut via Organization.defaultCurrencyId.
model Currency {
  id             String                 @id @default(uuid()) @db.Uuid
  /// Code ISO 4217 : "XAF", "EUR", "USD"
  code           String                 @unique
  /// Libellé complet : "Franc CFA BEAC", "Euro"
  name           String
  /// Symbole affiché : "XAF", "€", "$"
  symbol         String
  /// Position du symbole : BEFORE = "$ 5 000", AFTER = "5 000 XAF"
  symbolPosition CurrencySymbolPosition @default(AFTER)
  /// Nombre de décimales affichées (0 pour XAF)
  decimalPlaces  Int                    @default(0)
  /// false = devise masquée dans l'UI (soft-disable)
  isActive       Boolean                @default(true)
  organizations  Organization[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@map("currencies")
}

// ─── Tenants & plateforme ────────────────────────────────────────────────────

enum OrganizationStatus {
  TRIALING
  ACTIVE
  SUSPENDED
  CANCELED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

/// Plan tarifaire de la plateforme. Valeurs modifiables par le staff plateforme sans déploiement.
model Plan {
  id                    String         @id @default(uuid()) @db.Uuid
  /// Clé technique : "starter", "pro", "enterprise"
  name                  String         @unique
  /// Libellé affiché : "Starter", "Pro", "Enterprise"
  label                 String
  /// Prix mensuel en XAF (Decimal obligatoire — règle §17 point A)
  priceMonthly          Decimal        @db.Decimal(10, 2)
  /// Prix annuel en XAF
  priceAnnual           Decimal        @db.Decimal(10, 2)
  /// Durée d'essai standard après la fenêtre de lancement
  trialDurationDays     Int            @default(30)
  /// Plafond CA d'essai en XAF ; null = illimité (fenêtre de lancement ou enterprise)
  trialRevenueCapAmount Decimal?       @db.Decimal(12, 2)
  /// Nombre maximum d'utilisateurs ; null = illimité
  maxUsers              Int?
  /// Nombre maximum d'entrepôts ; null = illimité
  maxWarehouses         Int?
  /// Nombre maximum de produits ; null = illimité
  maxProducts           Int?
  isActive              Boolean        @default(true)
  subscriptions         Subscription[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@map("plans")
}

/// Abonnement actif d'une organisation. Une seule subscription active par org (contrainte unique).
model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @unique @db.Uuid
  planId            String             @db.Uuid
  status            SubscriptionStatus @default(TRIALING)
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean            @default(false)
  organization      Organization       @relation(fields: [organizationId], references: [id])
  plan              Plan               @relation(fields: [planId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  invoices Invoice[]

  @@index([planId])
  @@map("subscriptions")
}

/// Facture générée pour une période d'abonnement. Persist avant activation.
model Invoice {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  subscriptionId String         @db.Uuid
  amount         Decimal        @db.Decimal(10, 2)
  currency       String         @default("XAF")
  status         InvoiceStatus  @default(PENDING)
  /// URL de paiement générée par l'agrégateur
  paymentLink    String?
  paidAt         DateTime?
  dueAt          DateTime
  /// "monthly" | "annual" — conservé pour la relance automatique (invoice.renew)
  period         String         @default("monthly")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id])
  webhookEvents  WebhookEvent[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status])
  @@map("invoices")
}

/// Événement webhook persisté avant tout traitement (idempotence §17 point V).
/// La contrainte unique (provider, providerEventId) garantit qu'un rejeu est ignoré.
model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  payload         Json
  /// Horodatage de réception du webhook (avant traitement)
  receivedAt      DateTime  @default(now())
  /// Horodatage de fin de traitement métier ; null si le traitement a échoué ou est ignoré
  processedAt     DateTime?
  /// Tenant concerné — scopé quand l'invoiceId est résolvable
  organizationId  String?   @db.Uuid
  invoiceId       String?   @db.Uuid
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id])
  /// Vente POS concernée — résolu depuis le payload de l'agrégateur (S22, parallèle à invoiceId)
  saleId          String?   @db.Uuid
  sale            Sale?     @relation(fields: [saleId], references: [id])

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}

/// Paramètres plateforme modifiables sans redéploiement (clé/valeur JSON sérialisé).
/// Ex. : launchPromoEndsAt = "2026-09-30T23:59:59Z"
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

/// Organisation cliente (tenant). Chaque modèle métier est scopé par organizationId.
model Organization {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  /// Sous-domaine unique : boutique-durand → boutique-durand.monapp.com
  subdomain         String             @unique
  customDomain      String?            @unique
  logoUrl           String?
  /// Couleur principale HSL/hex appliquée au runtime (design system §3)
  primaryColor      String?
  status            OrganizationStatus @default(TRIALING)
  /// Date de fin d'essai calculée à l'inscription. Null pour les orgs antérieures à T04.
  /// Logique fenêtre de lancement différée à T06 (PlatformSetting.launchPromoEndsAt).
  trialEndsAt       DateTime?
  /// Raison d'une fin d'essai anticipée (ex. dépassement CA). Alimenté par billing-queue (T06/T07).
  trialEndedReason  String?
  /// Devise par défaut choisie par l'organisation (lecture seule pour les tenants non-admin).
  defaultCurrencyId String?            @db.Uuid
  defaultCurrency   Currency?          @relation(fields: [defaultCurrencyId], references: [id])
  createdAt         DateTime           @default(now())
  deletedAt         DateTime?

  users            User[]
  roles            Role[]
  subscription     Subscription?
  invoices         Invoice[]
  smtpServer       SmtpServer?
  backupExports    BackupExport[]
  warehouses       Warehouse[]
  categories       Category[]
  brands           Brand[]
  units            Unit[]
  products         Product[]
  clients          Client[]
  providers        Provider[]
  documentCounters DocumentCounter[]
  adjustments      Adjustment[]
  transfers        StockTransfer[]
  notifications    Notification[]
  sales            Sale[]
  paymentSales     PaymentSale[]
  cashSessions     CashSession[]
  purchases        Purchase[]
  paymentPurchases PaymentPurchase[]
  saleReturns      SaleReturn[]
  purchaseReturns  PurchaseReturn[]
  paymentReturns   PaymentReturn[]
  quotations       Quotation[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]

  @@map("organizations")
}

/// Configuration SMTP par organisation — mot de passe chiffré AES-256-GCM (§17 point S).
/// Ne jamais exposer passwordCipher dans une réponse HTTP.
model SmtpServer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @db.Uuid
  host           String
  port           Int          @default(587)
  username       String
  /// Chiffré en AES-256-GCM — format stocké : "iv:authTag:ciphertext" (hex)
  passwordCipher String
  fromEmail      String
  fromName       String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("smtp_servers")
}

/// Compte staff plateforme — auth séparée de celle des utilisateurs tenant.
model PlatformAdmin {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  /// Mot de passe hashé (bcrypt cost 12)
  password    String
  /// Secret TOTP chiffré AES-256-GCM via EncryptionService. Null si TOTP pas encore configuré.
  totpSecret  String?
  /// True dès que le TOTP a été vérifié une première fois (setup confirmé).
  totpEnabled Boolean  @default(false)
  /// False = compte désactivé, 401 générique au login.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("platform_admins")
}

// ─── Identité & contrôle d'accès ─────────────────────────────────────────────

/// Référentiel global des permissions — non scopé par organisation.
model Permission {
  id    String  @id @default(uuid()) @db.Uuid
  /// Clé technique unique, ex. "invoices.create"
  name  String  @unique
  /// Libellé lisible pour l'UI d'administration
  label String?

  roles PermissionOnRole[]

  @@map("permissions")
}

/// Utilisateur appartenant à un tenant (scopé par organizationId).
model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  firstname      String
  lastname       String
  email          String
  username       String
  /// Mot de passe hashé (bcrypt)
  password       String
  avatar         String?
  phone          String?
  /// false = compte désactivé (soft-disable sans suppression)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  roles            RoleOnUser[]
  adjustments      Adjustment[]
  transfers        StockTransfer[]
  notifications    Notification[]
  sales            Sale[]
  cancelledSales   Sale[]            @relation("SaleCancelledBy")
  paymentSales     PaymentSale[]
  cashSessions     CashSession[]
  purchases        Purchase[]
  paymentPurchases PaymentPurchase[]
  saleReturns      SaleReturn[]
  purchaseReturns  PurchaseReturn[]
  paymentReturns   PaymentReturn[]
  quotations       Quotation[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]

  /// Un email est unique au sein d'un tenant, pas globalement.
  @@unique([organizationId, email])
  /// Un username est unique au sein d'un tenant.
  @@unique([organizationId, username])
  @@map("users")
}

/// Rôle nommé, scopé par organisation.
model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  label          String?
  description    String?
  /// false = rôle désactivé
  status         Boolean @default(true)

  organization Organization       @relation(fields: [organizationId], references: [id])
  permissions  PermissionOnRole[]
  users        RoleOnUser[]

  @@unique([organizationId, name])
  @@map("roles")
}

/// Table de jonction User ↔ Role (relation N:N).
model RoleOnUser {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("roles_on_users")
}

/// Table de jonction Role ↔ Permission (relation N:N).
model PermissionOnRole {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("permissions_on_roles")
}

/// Journal d'audit des mutations sensibles (§17 point U).
/// organizationId est nullable pour les actions du staff plateforme.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorType      String // "USER" | "PLATFORM_ADMIN" | "SYSTEM"
  actorId        String?  @db.Uuid
  action         String // ex. "roles.update", "permissions.assign"
  entity         String // nom du modèle, ex. "Role"
  entityId       String?  @db.Uuid
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─── Sauvegarde / exports (T09) ──────────────────────────────────────────────

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExportFormat {
  CSV
  JSON
}

/// Export de données par organisation (§17 point N).
/// Un export ne contient jamais de données d'un autre tenant.
/// Stockage local storage/exports/<organizationId>/<exportId>.<ext> — TODO T09-debt: migrer vers S3-compatible (S13, §17 point Y).
model BackupExport {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  status         ExportStatus @default(PENDING)
  format         ExportFormat @default(CSV)
  /// Nom du fichier généré — null tant que le job n'a pas produit le fichier.
  filename       String?
  /// Taille en octets du fichier généré — null avant complétion.
  sizeBytes      Int?
  /// Message d'erreur interne — ne jamais exposer dans une réponse HTTP.
  errorMessage   String?
  requestedAt    DateTime     @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, requestedAt(sort: Desc)])
  @@map("backup_exports")
}

// ─── Référentiels tenant ──────────────────────────────────────────────────────

/// Entrepôt physique ou logique d'un tenant.
/// Soft delete : deletedAt DateTime? — pas de suppression physique (§17 point 7).
/// version Int : verrouillage optimiste pour les mouvements de stock (S15, §17 point B).
/// L'index unique partiel (organizationId, name) WHERE deleted_at IS NULL est créé
/// en SQL raw dans la migration (Prisma ne supporte pas les index partiels dans @@unique).
model Warehouse {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  name            String
  address         String?
  /// true = entrepôt par défaut de l'organisation (un seul par org, géré transactionnellement)
  isDefault       Boolean            @default(false)
  /// Compteur de version pour le verrouillage optimiste sur les mouvements de stock (S15)
  version         Int                @default(0)
  deletedAt       DateTime?
  organization    Organization       @relation(fields: [organizationId], references: [id])
  stocks          ProductWarehouse[]
  adjustments     Adjustment[]
  transfersFrom   StockTransfer[]    @relation("TransferFrom")
  transfersTo     StockTransfer[]    @relation("TransferTo")
  sales           Sale[]
  cashSessions    CashSession[]
  purchases       Purchase[]
  saleReturns     SaleReturn[]
  purchaseReturns PurchaseReturn[]
  quotations      Quotation[]
  expenses        Expense[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([organizationId])
  @@map("warehouses")
}

// ─── Catalogue tenant ─────────────────────────────────────────────────────────

/// Catégorie de produit, scopée par organisation (S10 — Bloc C).
/// Soft delete : index uniques partiels (organizationId, code) et (organizationId, name)
/// créés en SQL raw dans la migration (Prisma ne supporte pas les index partiels dans @@unique).
model Category {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  /// Code métier court, ex. "ELEC", "ALI" — majuscules et chiffres uniquement, 1–20 chars.
  code           String
  name           String
  deletedAt      DateTime?
  products       Product[]
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("categories")
}

/// Marque de produit, scopée par organisation (S10 — Bloc C).
/// image String? : URL logo — upload réel reporté à S13 (TODO S10-debt: upload réel S13).
model Brand {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  description    String?
  /// URL d'un logo de marque — TODO S10-debt: upload réel via stockage S13.
  image          String?
  deletedAt      DateTime?
  products       Product[]
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("brands")
}

/// Produit du catalogue tenant (S14 — Bloc D).
/// image String? : clé S3 — jamais URL directe (§17 point Y). URL signée générée à la volée.
/// cost / price / taxRate : Decimal obligatoire — jamais Float (§17 point A).
/// Soft delete : index unique partiel (organizationId, name) WHERE deleted_at IS NULL en SQL raw.
/// Un produit isVariant: true a des ProductVariant ; le stock réel est dans ProductWarehouse (S15).
model Product {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  /// Code de référence interne — unique par organisation (actifs)
  code           String
  /// Format du code-barres affiché côté client (ex. "EAN13", "CODE128", "QR")
  barcodeType    String?
  name           String
  /// Prix d'achat HT — Decimal obligatoire (§17 point A)
  cost           Decimal   @db.Decimal(14, 3)
  /// Prix de vente HT — Decimal obligatoire (§17 point A)
  price          Decimal   @db.Decimal(14, 3)
  categoryId     String    @db.Uuid
  brandId        String?   @db.Uuid
  /// Unité de stock par défaut (ex. "Pièce")
  unitId         String?   @db.Uuid
  /// Unité de vente (ex. "Carton") — peut différer de l'unité de stock
  unitSaleId     String?   @db.Uuid
  /// Unité d'achat (ex. "Carton") — peut différer de l'unité de stock
  unitPurchaseId String?   @db.Uuid
  /// Taux de TVA — ex. 0.1925 = 19,25 % — Decimal obligatoire (§17 point A)
  taxRate        Decimal   @default(0) @db.Decimal(5, 4)
  /// "percentage" | "fixed"
  taxMethod      String    @default("percentage")
  /// Clé S3 de l'image produit — jamais URL directe (§17 point Y)
  image          String?
  note           String?
  /// Seuil d'alerte de stock bas (entier, 0 = désactivé)
  stockAlert     Int       @default(0)
  /// true = produit avec variantes (tailles, couleurs…)
  isVariant      Boolean   @default(false)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id])
  category              Category               @relation(fields: [categoryId], references: [id])
  brand                 Brand?                 @relation(fields: [brandId], references: [id])
  unit                  Unit?                  @relation("ProductUnit", fields: [unitId], references: [id])
  unitSale              Unit?                  @relation("ProductUnitSale", fields: [unitSaleId], references: [id])
  unitPurchase          Unit?                  @relation("ProductUnitPurchase", fields: [unitPurchaseId], references: [id])
  variants              ProductVariant[]
  stocks                ProductWarehouse[]
  adjustmentDetails     AdjustmentDetail[]
  transferDetails       StockTransferDetail[]
  saleDetails           SaleDetail[]
  purchaseDetails       PurchaseDetail[]
  saleReturnDetails     SaleReturnDetail[]
  purchaseReturnDetails PurchaseReturnDetail[]
  quotationDetails      QuotationDetail[]

  /// Unicité (organizationId, code) — actifs et supprimés confondus (code non libéré par soft-delete)
  @@unique([organizationId, code])
  @@map("products")
}

/// Variante d'un produit (S14 — Bloc D).
/// Pas de champ quantity — unique source de vérité du stock = ProductWarehouse.productVariantId (S15).
model ProductVariant {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @db.Uuid
  /// Libellé de la variante (ex. "Rouge / L", "500 ml")
  name      String?
  deletedAt DateTime?

  product Product            @relation(fields: [productId], references: [id])
  stocks  ProductWarehouse[]

  @@map("product_variants")
}

/// Stock d'un produit (ou d'une variante) dans un entrepôt (S14 stub — géré en S15).
/// version Int : verrouillage optimiste pour tout mouvement de stock (§17 point B).
/// quantity Decimal — jamais Float (§17 point A).
model ProductWarehouse {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @db.Uuid
  warehouseId      String  @db.Uuid
  productVariantId String? @db.Uuid
  /// Quantité en stock — Decimal obligatoire (§17 point A)
  quantity         Decimal @default(0) @db.Decimal(14, 3)
  /// Compteur de version pour le verrouillage optimiste (S15, §17 point B)
  version          Int     @default(0)

  product   Product         @relation(fields: [productId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  /// Unicité appliquée par deux index partiels SQL (migration S14) :
  ///   "product_warehouse_no_variant_unique"   WHERE productVariantId IS NULL
  ///   "product_warehouse_with_variant_unique" WHERE productVariantId IS NOT NULL
  /// (PostgreSQL traite NULL ≠ NULL dans les contraintes UNIQUE — index partiels nécessaires)
  @@map("product_warehouse")
}

/// Unité de mesure / conditionnement, scopée par organisation (S11 — Bloc C).
/// Hiérarchie auto-référentielle max 1 niveau : une unité de base (baseUnitId = null)
/// ou une unité dérivée (baseUnitId non nul) — ex. Carton = 12 × Pièce.
/// operator "*" ou "/" ; operatorValue Decimal (facteur de conversion, §17 point A).
/// Soft delete : index uniques partiels (organizationId, name) et (organizationId, shortName)
/// créés en SQL raw dans la migration (WHERE deleted_at IS NULL).
model Unit {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  /// Libellé complet : "Pièce", "Carton", "Litre"
  name             String
  /// Nom court affiché : "pcs", "ctn", "L"
  shortName        String
  /// Null = unité de base ; non nul = unité dérivée (1 niveau max)
  baseUnitId       String?      @db.Uuid
  baseUnit         Unit?        @relation("UnitHierarchy", fields: [baseUnitId], references: [id])
  subUnits         Unit[]       @relation("UnitHierarchy")
  /// Opérateur de conversion : "*" (multiplication) ou "/" (division)
  operator         String       @default("*")
  /// Facteur de conversion — Decimal obligatoire (§17 point A)
  operatorValue    Decimal      @default(1) @db.Decimal(14, 6)
  deletedAt        DateTime?
  organization     Organization @relation(fields: [organizationId], references: [id])
  /// Produits référençant cette unité (stub S11 — colonnes complètes en S14)
  products         Product[]    @relation("ProductUnit")
  productsSale     Product[]    @relation("ProductUnitSale")
  productsPurchase Product[]    @relation("ProductUnitPurchase")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("units")
}

// ─── Partenaires tenant ───────────────────────────────────────────────────────

/// Client d'un tenant (S12 — Bloc C).
/// code : entier séquentiel par organisation, généré en transaction SERIALIZABLE.
/// Soft delete : index uniques partiels (organizationId, name) et (organizationId, code)
/// créés en SQL raw dans la migration (WHERE deleted_at IS NULL).
/// Le client "Walk-in" (code=1) est le client anonyme du POS — seedé automatiquement.
model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  /// Code séquentiel par organisation — généré transactionnellement, jamais saisi par l'utilisateur
  code           Int
  email          String?
  phone          String?
  country        String?
  city           String?
  address        String?
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  sales          Sale[]
  quotations     Quotation[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// Contrainte de sécurité : le filet final en cas de collision concurrente sur le code
  @@unique([organizationId, code])
  @@map("clients")
}

/// Fournisseur d'un tenant (S12 — Bloc C).
/// Même structure que Client — code séquentiel distinct par organisation.
model Provider {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  /// Code séquentiel par organisation — généré transactionnellement, jamais saisi par l'utilisateur
  code           Int
  email          String?
  phone          String?
  country        String?
  city           String?
  address        String?
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  purchases      Purchase[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@map("providers")
}

// ─── Génération transactionnelle des références de documents (§17 point X) ──

/// Types de documents financiers générant une référence séquentielle.
enum DocumentType {
  SALE
  PURCHASE
  QUOTATION
  SALE_RETURN
  PURCHASE_RETURN
  TRANSFER
  ADJUSTMENT
  /// Paiement d'une vente (S20) — séquence globale par organisation, indépendante de Sale.
  PAYMENT_SALE
  /// Paiement d'un achat fournisseur (S25) — séquence globale par organisation, indépendante de Purchase.
  PAYMENT_PURCHASE
  /// Session de caisse (S23b) — préfixe CS
  CASH_SESSION
  /// Paiement d'un retour (vente ou achat) — séquence globale par organisation, indépendante de SaleReturn/PurchaseReturn.
  PAYMENT_RETURN
  /// Dépense (S29) — préfixe DEP
  EXPENSE
}

/// Compteur de référence par (organisation, type de document, année civile).
/// Incrémenté dans la même transaction que la création du document (SELECT … FOR UPDATE ou upsert+increment).
/// Jamais de MAX(reference)+1 applicatif — source de collision en concurrence (§17 point X).
model DocumentCounter {
  organizationId String       @db.Uuid
  documentType   DocumentType
  year           Int
  /// Dernier compteur utilisé — incrémenté atomiquement dans la transaction de création.
  lastCounter    Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, documentType, year])
  @@map("document_counters")
}

// ─── Ajustements de stock (S16 — Bloc D) ─────────────────────────────────────

/// Statut d'un ajustement de stock.
/// DRAFT = brouillon (pas encore appliqué au stock).
/// VALIDATED = appliqué — immuable, ni modification ni suppression physique possible.
enum AdjustmentStatus {
  DRAFT
  VALIDATED
}

/// Sens du mouvement d'une ligne d'ajustement.
enum AdjustmentDetailType {
  ADDITION
  SOUSTRACTION
}

/// En-tête d'un ajustement de stock (S16 — Bloc D).
/// Patron identique à Sale/SaleDetail : l'organizationId est sur l'en-tête uniquement.
/// reference générée via DocumentCounterService.nextReference dans la transaction de création (§17 point X).
/// Soft delete uniquement (deletedAt) — un ajustement validé ne peut être ni modifié ni supprimé (§17 point 7).
model Adjustment {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  /// Référence unique par organisation — générée via DocumentCounter (ex. "ADJ-2026-000001")
  reference      String
  date           DateTime
  warehouseId    String           @db.Uuid
  userId         String           @db.Uuid
  note           String?
  status         AdjustmentStatus @default(DRAFT)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  user         User               @relation(fields: [userId], references: [id])
  details      AdjustmentDetail[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@map("adjustments")
}

/// Ligne d'un ajustement de stock (S16 — Bloc D).
/// quantity et unitCost en Decimal — jamais Float (§17 point A).
/// L'organizationId n'est pas répété ici — hérité via adjustment.organizationId.
model AdjustmentDetail {
  id               String               @id @default(uuid()) @db.Uuid
  adjustmentId     String               @db.Uuid
  productId        String               @db.Uuid
  productVariantId String?              @db.Uuid
  type             AdjustmentDetailType
  /// Quantité ajustée — Decimal obligatoire (§17 point A), toujours positive
  quantity         Decimal              @db.Decimal(14, 3)
  /// Coût unitaire pour valorisation — Decimal obligatoire (§17 point A)
  unitCost         Decimal              @default(0) @db.Decimal(14, 3)

  adjustment Adjustment @relation(fields: [adjustmentId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@map("adjustment_details")
}

// ─── Transferts de stock entre entrepôts (S17 — Bloc D) ──────────────────────

/// Statut d'un transfert de stock.
/// DRAFT = brouillon (pas encore appliqué au stock).
/// VALIDATED = appliqué — immuable, ni modification ni suppression physique possible.
enum TransferStatus {
  DRAFT
  VALIDATED
}

/// En-tête d'un transfert de stock (S17 — Bloc D).
/// Patron identique à Sale/SaleDetail : organizationId sur l'en-tête uniquement.
/// reference générée via DocumentCounterService.nextReference (§17 point X) — format TRF-YYYY-NNNNNN.
/// Atomicité : validation décrémente fromWarehouse ET incrémente toWarehouse dans la même transaction.
/// Soft delete uniquement (deletedAt) — un transfert validé ne peut être ni modifié ni supprimé (§17 point 7).
model StockTransfer {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  /// Référence unique par organisation — générée via DocumentCounter (ex. "TRF-2026-000001")
  reference       String
  date            DateTime
  fromWarehouseId String         @db.Uuid
  toWarehouseId   String         @db.Uuid
  userId          String         @db.Uuid
  note            String?
  status          TransferStatus @default(DRAFT)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id])
  fromWarehouse Warehouse             @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse             @relation("TransferTo", fields: [toWarehouseId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  details       StockTransferDetail[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@map("stock_transfers")
}

/// Ligne d'un transfert de stock (S17 — Bloc D).
/// quantity en Decimal — jamais Float (§17 point A).
/// L'organizationId n'est pas répété ici — hérité via transfer.organizationId.
model StockTransferDetail {
  id               String  @id @default(uuid()) @db.Uuid
  transferId       String  @db.Uuid
  productId        String  @db.Uuid
  productVariantId String? @db.Uuid
  /// Quantité transférée — Decimal obligatoire (§17 point A), toujours positive
  quantity         Decimal @db.Decimal(14, 3)

  transfer StockTransfer @relation(fields: [transferId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])

  @@map("stock_transfer_details")
}

// ─── Notifications (S18 — Bloc D) ────────────────────────────────────────────

/// Notification persistante par utilisateur (§17 point I — S18).
/// Persiste ce que Socket.io ne fait que diffuser en direct : si aucun client
/// n'est connecté au moment de l'émission, la notification est retrouvée
/// à la prochaine connexion.
/// type : "stock.lowAlert" | "backup.completed" | …
/// payload : données spécifiques au type (ex. { productId, productName, … })
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  /// Catégorie machine-readable : "stock.lowAlert", "backup.completed", …
  type           String
  /// Données spécifiques au type — structure définie par le service émetteur.
  payload        Json
  /// Null = non lue ; posé à now() par markAsRead / markAllAsRead.
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

// ─── Ventes classiques hors-POS (S19 — Bloc E) ───────────────────────────────

/// Statut de paiement d'un document financier — toujours dérivé des paiements,
/// jamais saisi manuellement (§17 point 6). Posé à UNPAID à la création (S19) ;
/// recalculé par PaymentSale en S20.
enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

/// Statut de cycle de vie d'un document financier (vente, achat, devis…).
/// PENDING = créé, modifiable/supprimable. AWAITING_PAYMENT = paiement mobile money
/// en attente de webhook (S20). COMPLETED = finalisé, immuable. CANCELLED = annulé
/// avec restitution de stock (S21b) — jamais de suppression physique (§17 point 7).
enum DocumentStatus {
  PENDING
  AWAITING_PAYMENT
  COMPLETED
  CANCELLED
}

/// En-tête d'une vente classique hors-POS (S19 — Bloc E, §18.3).
/// Patron identique à Adjustment/StockTransfer : organizationId sur l'en-tête uniquement,
/// reference générée via DocumentCounterService.nextReference dans la transaction de
/// création (§17 point X) — format VTE-YYYY-NNNNNN.
/// grandTotal et les totaux de ligne sont calculés côté serveur uniquement, jamais
/// depuis le body client (§17 point A). paidAmount reste à 0 tant que S20 (PaymentSale)
/// n'est pas branché ; paymentStatus reste UNPAID à la création.
/// Soft delete uniquement (deletedAt) — un document COMPLETED ou CANCELLED est immuable
/// (§17 point 7) : ni modification, ni suppression, réservées au statut PENDING.
model Sale {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  /// Référence unique par organisation — générée via DocumentCounter (ex. "VTE-2026-000001")
  reference      String
  date           DateTime
  /// true = vente issue du POS (S22–S23) — S19 ne crée que des ventes classiques (false)
  isPos          Boolean        @default(false)
  userId         String         @db.Uuid
  clientId       String         @db.Uuid
  warehouseId    String         @db.Uuid
  /// Session de caisse ouverte au moment de l'encaissement (S23b) — null pour une vente hors-POS
  cashSessionId  String?        @db.Uuid
  /// Taux de TVA global — ex. 0.1925 = 19,25 % — Decimal obligatoire (§17 point A)
  taxRate        Decimal?       @default(0) @db.Decimal(14, 3)
  /// Montant de TVA global si taxMethod global = "fixed"
  taxAmount      Decimal?       @default(0) @db.Decimal(14, 3)
  discount       Decimal?       @default(0) @db.Decimal(14, 3)
  shipping       Decimal?       @default(0) @db.Decimal(14, 3)
  /// Total calculé côté serveur — jamais depuis le body client (§17 point A)
  grandTotal     Decimal        @default(0) @db.Decimal(14, 3)
  /// Somme des paiements — posé à 0 en S19, mis à jour par PaymentSale en S20
  paidAmount     Decimal        @default(0) @db.Decimal(14, 3)
  paymentStatus  PaymentStatus  @default(UNPAID)
  status         DocumentStatus @default(PENDING)
  notes          String?
  /// Raison obligatoire de l'annulation (S21b, §18.18) — renseignée uniquement si status = CANCELLED
  cancelReason   String?
  cancelledAt    DateTime?
  /// Acteur de l'annulation — null si annulée par le job d'expiration mobile money (§17 point V, S22)
  cancelledById  String?        @db.Uuid
  /// Devis d'origine si cette vente est issue d'une conversion (S28, §18.4) — null pour une
  /// vente créée directement. @unique : un devis se convertit en AU PLUS une vente.
  quotationId    String?        @unique @db.Uuid
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  client        Client         @relation(fields: [clientId], references: [id])
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  cancelledBy   User?          @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  cashSession   CashSession?   @relation(fields: [cashSessionId], references: [id])
  quotation     Quotation?     @relation(fields: [quotationId], references: [id])
  details       SaleDetail[]
  payments      PaymentSale[]
  webhookEvents WebhookEvent[]
  saleReturns   SaleReturn[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, paymentStatus])
  /// Chemin le plus fréquent de findAll (viewAll=false, §17 — index requis pour toute requête filtrée)
  @@index([organizationId, userId])
  @@index([organizationId, clientId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, cashSessionId])
  @@map("sales")
}

/// Ligne d'une vente (S19 — Bloc E).
/// price/taxAmount/discount/quantity/total en Decimal — jamais Float (§17 point A).
/// L'organizationId n'est pas répété ici — hérité via sale.organizationId.
/// total = (price × quantity) + taxLigne − remiseLigne, calculé côté serveur (voir SaleService).
model SaleDetail {
  id               String   @id @default(uuid()) @db.Uuid
  saleId           String   @db.Uuid
  productId        String   @db.Uuid
  productVariantId String?  @db.Uuid
  /// Unité de vente choisie pour cette ligne — optionnelle, référence Unit (conversion §17)
  saleUnitId       String?  @db.Uuid
  price            Decimal  @db.Decimal(14, 3)
  taxAmount        Decimal? @default(0) @db.Decimal(14, 3)
  /// "percentage" | "fixed"
  taxMethod        String?  @default("percentage")
  discount         Decimal? @default(0) @db.Decimal(14, 3)
  /// "percentage" | "fixed"
  discountMethod   String?  @default("percentage")
  quantity         Decimal  @db.Decimal(14, 3)
  total            Decimal  @db.Decimal(14, 3)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  saleReturnDetails SaleReturnDetail[]

  @@map("sale_details")
}

/// Moyen de paiement d'un encaissement de vente (S20).
enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
}

/// Paiement encaissé sur une vente (S20 — complète le stub posé en S19).
/// organizationId est dénormalisé depuis sale.organizationId pour éviter un join sur
/// chaque contrôle IDOR. reference générée via DocumentCounterService.nextReference
/// avec DocumentType.PAYMENT_SALE — séquence globale par organisation (format
/// PAY-YYYY-NNNNNN), pas dérivée de la référence de la vente.
/// Pas de soft delete : PaymentSale n'est pas un document financier au sens de la règle
/// §17 point 7 (pas de DocumentStatus propre) — la suppression est physique, la
/// traçabilité est assurée par AuditLog (@Auditable sur la route DELETE).
/// Sale.paidAmount/paymentStatus sont recalculés à chaque create/update/remove par
/// PaymentSaleService — jamais saisis directement (§17 point 6).
model PaymentSale {
  id             String        @id @default(uuid()) @db.Uuid
  saleId         String        @db.Uuid
  organizationId String        @db.Uuid
  /// Utilisateur qui a encaissé le paiement
  userId         String        @db.Uuid
  date           DateTime
  /// Référence unique par organisation — générée via DocumentCounter (ex. "PAY-2026-000001")
  reference      String
  amount         Decimal       @db.Decimal(14, 3)
  method         PaymentMethod
  /// Monnaie rendue au client (paiement espèces) — Decimal obligatoire (§17 point A)
  change         Decimal?      @default(0) @db.Decimal(14, 3)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sale         Sale         @relation(fields: [saleId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, saleId])
  @@map("payment_sales")
}

// ─── Devis (S28, §18.4) ───────────────────────────────────────────────────────

/// En-tête d'un devis (S28, §18.4). Mirror exact de Sale (S19), MAIS sans paymentStatus ni
/// paidAmount (un devis n'est jamais payé — aucun cycle de paiement tant qu'il reste un
/// devis), sans isPos ni cashSessionId (aucun lien caisse, un devis n'est jamais un
/// encaissement POS direct) et sans cancelReason/cancelledAt/cancelledById (un devis ne
/// s'annule pas dans cette session — pas de mouvement financier ni de stock à défaire,
/// contrairement à Sale.cancel() en S21b).
/// Un devis n'entraîne AUCUN mouvement de stock à aucun moment de son cycle de vie : le
/// stock n'est décrémenté qu'à la conversion en vente (voir Sale.quotationId ci-dessous),
/// via SaleService.create (S19), jamais ici.
/// reference générée via DocumentCounterService.nextReference avec DocumentType.QUOTATION
/// dans la transaction de création (§17 point X) — format DEV-YYYY-NNNNNN.
/// grandTotal et les totaux de ligne sont calculés côté serveur uniquement, jamais depuis
/// le body client (§17 point A).
/// Soft delete uniquement (deletedAt) — mêmes règles d'immuabilité que Sale (§17 point 7) :
/// un document COMPLETED est immuable, seul PENDING peut être modifié/supprimé.
model Quotation {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  /// Référence unique par organisation — générée via DocumentCounter (ex. "DEV-2026-000001")
  reference      String
  date           DateTime
  userId         String         @db.Uuid
  clientId       String         @db.Uuid
  warehouseId    String         @db.Uuid
  /// Taux de TVA global — ex. 0.1925 = 19,25 % — Decimal obligatoire (§17 point A)
  taxRate        Decimal?       @default(0) @db.Decimal(14, 3)
  /// Montant de TVA global si taxMethod global = "fixed"
  taxAmount      Decimal?       @default(0) @db.Decimal(14, 3)
  discount       Decimal?       @default(0) @db.Decimal(14, 3)
  shipping       Decimal?       @default(0) @db.Decimal(14, 3)
  /// Total calculé côté serveur — jamais depuis le body client (§17 point A)
  grandTotal     Decimal        @default(0) @db.Decimal(14, 3)
  status         DocumentStatus @default(PENDING)
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  client       Client            @relation(fields: [clientId], references: [id])
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  details      QuotationDetail[]
  /// Vente issue de la conversion de ce devis (S28) — au plus une, Sale.quotationId est @unique.
  /// Relation inverse portée par Sale (c'est Sale qui a la FK quotationId).
  sale         Sale?

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, userId])
  @@index([organizationId, clientId])
  @@index([organizationId, warehouseId])
  @@map("quotations")
}

/// Ligne d'un devis (S28). Mirror exact de SaleDetail, quoteUnitId au lieu de saleUnitId.
/// price/taxAmount/discount/quantity/total en Decimal — jamais Float (§17 point A).
/// L'organizationId n'est pas répété ici — hérité via quotation.organizationId.
model QuotationDetail {
  id               String   @id @default(uuid()) @db.Uuid
  quotationId      String   @db.Uuid
  productId        String   @db.Uuid
  productVariantId String?  @db.Uuid
  /// Unité choisie pour cette ligne — optionnelle, référence Unit (conversion §17)
  quoteUnitId      String?  @db.Uuid
  price            Decimal  @db.Decimal(14, 3)
  taxAmount        Decimal? @default(0) @db.Decimal(14, 3)
  /// "percentage" | "fixed"
  taxMethod        String?  @default("percentage")
  discount         Decimal? @default(0) @db.Decimal(14, 3)
  /// "percentage" | "fixed"
  discountMethod   String?  @default("percentage")
  quantity         Decimal  @db.Decimal(14, 3)
  total            Decimal  @db.Decimal(14, 3)

  quotation Quotation @relation(fields: [quotationId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@map("quotation_details")
}

// ─── Achats fournisseurs (S25 — Bloc F, §18.7) ───────────────────────────────

/// En-tête d'un achat fournisseur (S25 — Bloc F, §18.7).
/// Mirror exact de Sale, en sens inverse : validate() incrémente le stock au lieu de le
/// décrémenter. Pas de isPos (n'existe que pour les ventes POS), pas de cashSessionId
/// (aucun lien caisse pour un achat). status ne prend que PENDING/COMPLETED/CANCELLED en
/// pratique dans cette session (AWAITING_PAYMENT n'a de sens que pour le mobile money POS,
/// enum partagé DocumentStatus). PAS de cancelReason/cancelledAt/cancelledById : cancel()
/// n'est pas implémenté dans cette session (purchases.cancel existe déjà en seed mais
/// aucune session du plan ne le couvre encore) — ces colonnes n'arriveront qu'avec la
/// session qui implémentera l'annulation, comme Sale ne les a reçues qu'en S21b (pas S19).
model Purchase {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  /// Référence unique par organisation — générée via DocumentCounter (ex. "ACH-2026-000001")
  reference      String
  date           DateTime
  userId         String         @db.Uuid
  providerId     String         @db.Uuid
  warehouseId    String         @db.Uuid
  taxRate        Decimal?       @default(0) @db.Decimal(14, 3)
  taxAmount      Decimal?       @default(0) @db.Decimal(14, 3)
  discount       Decimal?       @default(0) @db.Decimal(14, 3)
  shipping       Decimal?       @default(0) @db.Decimal(14, 3)
  grandTotal     Decimal        @default(0) @db.Decimal(14, 3)
  paidAmount     Decimal        @default(0) @db.Decimal(14, 3)
  paymentStatus  PaymentStatus  @default(UNPAID)
  status         DocumentStatus @default(PENDING)
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id])
  provider        Provider          @relation(fields: [providerId], references: [id])
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  details         PurchaseDetail[]
  payments        PaymentPurchase[]
  purchaseReturns PurchaseReturn[]

  @@unique([organizationId, reference])
  @@index([organizationId, userId])
  @@index([organizationId, providerId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, status])
  @@index([organizationId, paymentStatus])
  @@map("purchases")
}

/// Ligne d'un achat fournisseur (S25 — Bloc F). Mirror exact de SaleDetail, purchaseUnitId
/// au lieu de saleUnitId. price = coût d'achat de la ligne (peut différer de Product.cost
/// au moment T, c'est une saisie, pas une recopie automatique).
/// L'organizationId n'est pas répété ici — hérité via purchase.organizationId.
model PurchaseDetail {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseId       String   @db.Uuid
  productId        String   @db.Uuid
  productVariantId String?  @db.Uuid
  /// Unité d'achat choisie pour cette ligne — optionnelle, référence Unit (conversion §17)
  purchaseUnitId   String?  @db.Uuid
  price            Decimal  @db.Decimal(14, 3)
  taxAmount        Decimal? @default(0) @db.Decimal(14, 3)
  /// "percentage" | "fixed"
  taxMethod        String?  @default("percentage")
  discount         Decimal? @default(0) @db.Decimal(14, 3)
  /// "percentage" | "fixed"
  discountMethod   String?  @default("percentage")
  quantity         Decimal  @db.Decimal(14, 3)
  total            Decimal  @db.Decimal(14, 3)

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  purchaseReturnDetails PurchaseReturnDetail[]

  @@map("purchase_details")
}

/// Paiement fournisseur encaissé sur un achat (S25 — mirror exact de PaymentSale).
/// organizationId est dénormalisé depuis purchase.organizationId pour éviter un join sur
/// chaque contrôle IDOR. reference générée via DocumentCounterService.nextReference avec
/// DocumentType.PAYMENT_PURCHASE — séquence globale par organisation (format
/// PAA-YYYY-NNNNNN), pas dérivée de la référence de l'achat.
/// Pas de soft delete : PaymentPurchase n'est pas un document financier au sens de la règle
/// §17 point 7 (pas de DocumentStatus propre) — la suppression est physique, la
/// traçabilité est assurée par AuditLog (@Auditable sur la route DELETE).
/// Purchase.paidAmount/paymentStatus sont recalculés à chaque create/update/remove par
/// PaymentPurchaseService — jamais saisis directement (§17 point 6).
model PaymentPurchase {
  id             String        @id @default(uuid()) @db.Uuid
  purchaseId     String        @db.Uuid
  organizationId String        @db.Uuid
  /// Utilisateur qui a encaissé le paiement
  userId         String        @db.Uuid
  date           DateTime
  /// Référence unique par organisation — générée via DocumentCounter (ex. "PAA-2026-000001")
  reference      String
  amount         Decimal       @db.Decimal(14, 3)
  method         PaymentMethod
  /// Monnaie rendue au fournisseur (paiement espèces) — Decimal obligatoire (§17 point A)
  change         Decimal?      @default(0) @db.Decimal(14, 3)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  purchase     Purchase     @relation(fields: [purchaseId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, purchaseId])
  @@map("payment_purchases")
}

/// Session de caisse (S23b, §18.2) : ouverture/clôture avec fond de caisse et écart de comptage.
/// "Chacun sa caisse" : une seule session OPEN par (organizationId, userId) — index unique partiel
/// créé en SQL raw dans la migration (Prisma ne supporte pas les index partiels dans @@unique).
/// status en String "OPEN"/"CLOSED" (pas d'enum Prisma dédié) — volontairement simple.
model CashSession {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @db.Uuid
  /// Référence via DocumentCounterService — jamais max+1 (§17 point X)
  reference             String
  warehouseId           String    @db.Uuid
  userId                String    @db.Uuid
  /// Fond de caisse déclaré à l'ouverture
  openingAmount         Decimal   @db.Decimal(14, 3)
  /// Calculé à la clôture : openingAmount + somme des PaymentSale CASH rattachés
  expectedClosingAmount Decimal?  @db.Decimal(14, 3)
  /// Saisi par le caissier au comptage physique
  countedClosingAmount  Decimal?  @db.Decimal(14, 3)
  /// countedClosingAmount - expectedClosingAmount (positif = excédent, négatif = manque)
  variance              Decimal?  @db.Decimal(14, 3)
  status                String    @default("OPEN")
  notes                 String?
  openedAt              DateTime  @default(now())
  closedAt              DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  sales        Sale[]

  @@unique([organizationId, reference])
  @@index([organizationId, userId, status])
  @@map("cash_sessions")
}

// ─── Retours de vente et d'achat (S26 — Bloc F/E, §18.6) ─────────────────────

/// En-tête d'un retour de vente (S26, §18.6). Mirror de Sale, sans isPos ni cashSessionId
/// (un retour n'est jamais un encaissement POS direct) et sans cancelReason/cancelledAt/
/// cancelledById — pas d'annulation dans cette session, comme Purchase (S25). validate()
/// restitue le stock au lieu de le décrémenter (sens inverse de Sale.validate() — service
/// des agents suivants). saleId référence le document de vente d'origine — obligatoire,
/// un retour ne peut exister sans vente source. Les lignes (SaleReturnDetail) référencent
/// en plus la SaleDetail précise, pour borner la quantité retournable cumulée et pour la
/// vérification anti-IDOR (une ligne de retour doit référencer une SaleDetail qui
/// appartient bien au Sale déclaré). Soft delete uniquement (deletedAt) — mêmes règles
/// d'immuabilité que Sale/Purchase (§17 point 7).
model SaleReturn {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  /// Référence unique par organisation — générée via DocumentCounter (ex. "RVT-2026-000001")
  reference      String
  date           DateTime
  userId         String         @db.Uuid
  /// Vente d'origine — le retour ne peut porter que sur les lignes de ce document
  saleId         String         @db.Uuid
  warehouseId    String         @db.Uuid
  /// Taux de TVA global — ex. 0.1925 = 19,25 % — Decimal obligatoire (§17 point A)
  taxRate        Decimal?       @default(0) @db.Decimal(14, 3)
  /// Montant de TVA global si taxMethod global = "fixed"
  taxAmount      Decimal?       @default(0) @db.Decimal(14, 3)
  discount       Decimal?       @default(0) @db.Decimal(14, 3)
  shipping       Decimal?       @default(0) @db.Decimal(14, 3)
  /// Total calculé côté serveur — jamais depuis le body client (§17 point A)
  grandTotal     Decimal        @default(0) @db.Decimal(14, 3)
  /// Somme des paiements (remboursements) — recalculé par PaymentReturnService
  paidAmount     Decimal        @default(0) @db.Decimal(14, 3)
  paymentStatus  PaymentStatus  @default(UNPAID)
  status         DocumentStatus @default(PENDING)
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  sale         Sale               @relation(fields: [saleId], references: [id])
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id])
  user         User               @relation(fields: [userId], references: [id])
  details      SaleReturnDetail[]
  payments     PaymentReturn[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, paymentStatus])
  /// Chemin le plus fréquent de findAll (viewAll=false, §17 — index requis pour toute requête filtrée)
  @@index([organizationId, userId])
  @@index([organizationId, warehouseId])
  /// Nécessaire pour sommer les quantités déjà retournées sur un document de vente donné.
  @@index([organizationId, saleId])
  @@map("sale_returns")
}

/// Ligne d'un retour de vente (S26). Mirror de SaleDetail, avec en plus saleDetailId qui
/// pointe la ligne d'origine précise (pas seulement le document) — essentiel pour borner
/// la quantité retournable cumulée et pour la vérification anti-IDOR (une SaleDetail doit
/// appartenir au Sale référencé par le SaleReturn parent — vérifié en application).
/// L'organizationId n'est pas répété ici — hérité via saleReturn.organizationId.
model SaleReturnDetail {
  id               String   @id @default(uuid()) @db.Uuid
  saleReturnId     String   @db.Uuid
  /// Ligne de vente d'origine précise — voir commentaire du modèle
  saleDetailId     String   @db.Uuid
  productId        String   @db.Uuid
  productVariantId String?  @db.Uuid
  /// Unité de retour choisie pour cette ligne — optionnelle, mirror saleUnitId (conversion §17)
  returnUnitId     String?  @db.Uuid
  price            Decimal  @db.Decimal(14, 3)
  taxAmount        Decimal? @default(0) @db.Decimal(14, 3)
  /// "percentage" | "fixed"
  taxMethod        String?  @default("percentage")
  discount         Decimal? @default(0) @db.Decimal(14, 3)
  /// "percentage" | "fixed"
  discountMethod   String?  @default("percentage")
  quantity         Decimal  @db.Decimal(14, 3)
  total            Decimal  @db.Decimal(14, 3)

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id])
  saleDetail SaleDetail @relation(fields: [saleDetailId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  /// Utilisé pour sommer les quantités déjà retournées sur cette ligne d'origine à travers
  /// tous les retours (borne anti-sur-retour).
  @@index([saleDetailId])
  @@map("sale_return_details")
}

/// En-tête d'un retour fournisseur (S26). Mirror de Purchase, avec purchaseId au lieu de
/// providerId — le retour référence l'achat d'origine, pas directement le fournisseur
/// (mirror strict du besoin, cf. SaleReturn.saleId). validate() décrémente le stock au
/// lieu de l'incrémenter (sens inverse de Purchase.validate() — service des agents
/// suivants). Pas de cancelReason/cancelledAt/cancelledById, comme Purchase (S25).
model PurchaseReturn {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  /// Référence unique par organisation — générée via DocumentCounter (ex. "RAC-2026-000001")
  reference      String
  date           DateTime
  userId         String         @db.Uuid
  /// Achat d'origine — le retour ne peut porter que sur les lignes de ce document
  purchaseId     String         @db.Uuid
  warehouseId    String         @db.Uuid
  taxRate        Decimal?       @default(0) @db.Decimal(14, 3)
  taxAmount      Decimal?       @default(0) @db.Decimal(14, 3)
  discount       Decimal?       @default(0) @db.Decimal(14, 3)
  shipping       Decimal?       @default(0) @db.Decimal(14, 3)
  grandTotal     Decimal        @default(0) @db.Decimal(14, 3)
  paidAmount     Decimal        @default(0) @db.Decimal(14, 3)
  paymentStatus  PaymentStatus  @default(UNPAID)
  status         DocumentStatus @default(PENDING)
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  purchase     Purchase               @relation(fields: [purchaseId], references: [id])
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id])
  user         User                   @relation(fields: [userId], references: [id])
  details      PurchaseReturnDetail[]
  payments     PaymentReturn[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, userId])
  @@index([organizationId, warehouseId])
  /// Nécessaire pour sommer les quantités déjà retournées sur un document d'achat donné.
  @@index([organizationId, purchaseId])
  @@map("purchase_returns")
}

/// Ligne d'un retour fournisseur (S26). Mirror de PurchaseDetail, avec en plus
/// purchaseDetailId qui pointe la ligne d'achat d'origine précise — même rôle que
/// SaleReturnDetail.saleDetailId (borne de quantité + anti-IDOR).
/// L'organizationId n'est pas répété ici — hérité via purchaseReturn.organizationId.
model PurchaseReturnDetail {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseReturnId String   @db.Uuid
  /// Ligne d'achat d'origine précise — voir commentaire du modèle
  purchaseDetailId String   @db.Uuid
  productId        String   @db.Uuid
  productVariantId String?  @db.Uuid
  /// Unité de retour choisie pour cette ligne — optionnelle, mirror purchaseUnitId (conversion §17)
  returnUnitId     String?  @db.Uuid
  price            Decimal  @db.Decimal(14, 3)
  taxAmount        Decimal? @default(0) @db.Decimal(14, 3)
  /// "percentage" | "fixed"
  taxMethod        String?  @default("percentage")
  discount         Decimal? @default(0) @db.Decimal(14, 3)
  /// "percentage" | "fixed"
  discountMethod   String?  @default("percentage")
  quantity         Decimal  @db.Decimal(14, 3)
  total            Decimal  @db.Decimal(14, 3)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  purchaseDetail PurchaseDetail @relation(fields: [purchaseDetailId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])

  /// Utilisé pour sommer les quantités déjà retournées sur cette ligne d'origine à travers
  /// tous les retours (borne anti-sur-retour).
  @@index([purchaseDetailId])
  @@map("purchase_return_details")
}

/// Paiement (remboursement) enregistré sur un retour, vente ou achat (S26). Mirror de
/// PaymentSale/PaymentPurchase, mais avec deux FK nullables en parallèle — parallèle exact
/// du patron WebhookEvent.saleId/invoiceId : exactement un des deux (saleReturnId,
/// purchaseReturnId) doit être renseigné. Invariant vérifié en application (services des
/// agents suivants) ET par une contrainte CHECK SQL (num_nonnulls) ajoutée à la main dans
/// la migration — défense en profondeur, jamais uniquement applicatif sur un invariant
/// critique (cf. philosophie RLS du projet, §17 point T).
/// reference générée via DocumentCounterService.nextReference avec
/// DocumentType.PAYMENT_RETURN — séquence globale par organisation (format
/// REM-YYYY-NNNNNN), indépendante de SaleReturn/PurchaseReturn.
/// Pas de soft delete : comme PaymentSale/PaymentPurchase, ce n'est pas un document
/// financier au sens de la règle §17 point 7 — suppression physique, traçabilité par
/// AuditLog (@Auditable sur la route DELETE).
model PaymentReturn {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @db.Uuid
  /// Retour de vente concerné — exactement un des deux (saleReturnId, purchaseReturnId) est non-null
  saleReturnId     String?         @db.Uuid
  saleReturn       SaleReturn?     @relation(fields: [saleReturnId], references: [id])
  /// Retour fournisseur concerné — exactement un des deux (saleReturnId, purchaseReturnId) est non-null
  purchaseReturnId String?         @db.Uuid
  purchaseReturn   PurchaseReturn? @relation(fields: [purchaseReturnId], references: [id])
  /// Utilisateur qui a enregistré le paiement
  userId           String          @db.Uuid
  date             DateTime
  /// Référence unique par organisation — générée via DocumentCounter (ex. "REM-2026-000001")
  reference        String
  amount           Decimal         @db.Decimal(14, 3)
  method           PaymentMethod
  /// Monnaie rendue (paiement espèces) — Decimal obligatoire (§17 point A)
  change           Decimal?        @default(0) @db.Decimal(14, 3)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, saleReturnId])
  @@index([organizationId, purchaseReturnId])
  @@map("payment_returns")
}

// ─── Dépenses (S29) ───────────────────────────────────────────────────────────

/// Catégorie de dépense (S29) — CRUD simple, pas de cycle de vie. Mirror structurel de
/// Category/Brand (référentiel tenant, soft delete uniquement).
model ExpenseCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  /// Utilisateur ayant créé la catégorie
  userId         String       @db.Uuid
  name           String
  description    String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  expenses     Expense[]

  @@map("expense_categories")
}

/// Dépense (S29) — CRUD simple, PAS de statut de cycle de vie (contrairement à
/// Sale/Purchase/Quotation) : ni PENDING/COMPLETED, ni mouvement de stock, ni paiement
/// partiel. reference générée via DocumentCounterService.nextReference avec
/// DocumentType.EXPENSE (format DEP-YYYY-NNNNNN), dans la transaction de création
/// (§17 point 4 — jamais MAX(reference)+1). amount : Decimal obligatoire, jamais Float
/// (§17 point A). Soft delete uniquement (deletedAt) — pas de suppression physique.
model Expense {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  date              DateTime
  /// Référence unique par organisation — générée via DocumentCounter (ex. "DEP-2026-000001")
  reference         String
  userId            String    @db.Uuid
  expenseCategoryId String    @db.Uuid
  warehouseId       String    @db.Uuid
  /// Libellé / description libre de la dépense — obligatoire (contrairement à
  /// ExpenseCategory.description, un complément optionnel de la catégorie).
  details           String
  amount            Decimal   @db.Decimal(14, 3)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  expenseCategory ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])

  @@unique([organizationId, reference])
  @@index([organizationId, expenseCategoryId])
  @@index([organizationId, warehouseId])
  @@index([organizationId, date])
  @@index([organizationId, userId])
  @@map("expenses")
}
