# Exclure les dossiers de build et caches
.git
.turbo
*.log
.env
.env.local

# Exclure les dist des packages (apps/web/dist est copié explicitement par apps/web/Dockerfile ;
# apps/api/dist est reconstruit dans le stage builder de apps/api/Dockerfile, jamais copié depuis
# l'hôte)
packages/*/dist
apps/api/dist
apps/mobile

# node_modules jamais copiés depuis l'hôte : symlinks pnpm absolus Windows incompatibles Linux.
# apps/api/Dockerfile fait un `pnpm install` frais dans son stage builder (conteneur Linux).
node_modules
apps/*/node_modules
packages/*/node_modules
